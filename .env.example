# Copy to .env and adjust as needed. docker-compose.yml reads these automatically.

# --- ClickHouse ---
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DB=cognistream

# --- Airflow metadata database (Postgres) ---
POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow
POSTGRES_DB=airflow

# --- Airflow webserver admin login ---
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=admin
AIRFLOW_ADMIN_EMAIL=admin@example.com

# --- Frontend build-time API base URL ---
# Leave empty in Docker (nginx proxies /api -> backend). For `npm run dev`
# outside Docker, set to http://localhost:8000.
VITE_API_BASE_URL=
